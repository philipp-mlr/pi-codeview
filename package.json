{
  "name": "pi-nvim",
  "version": "0.1.0",
  "description": "pi in Neovim: ask with context, watch the agent work, annotate, optional checkpoints",
  "keywords": [
    "pi-package"
  ],
  "license": "MIT",
  "type": "module",
  "files": [
    "extensions",
